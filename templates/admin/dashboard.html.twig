{# templates/admin/dashboard.html.twig #}
{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard | Gamora Admin{% endblock %}

{% block body %}
    <h2 style="color: white; margin-bottom: 20px; font-size: 22px; font-weight: 600;">Dashboard</h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 25px;">
        <div class="card" style="padding: 20px;">
            <h4 style="color: #64748b; font-size: 14px; margin-bottom: 8px;">Active Rigs</h4>
            <div style="font-size: 28px; font-weight: bold; color: var(--accent);">24 / 30</div>
        </div>
        <div class="card" style="padding: 20px;">
            <h4 style="color: #64748b; font-size: 14px; margin-bottom: 8px;">Today's Revenue</h4>
            <div style="font-size: 28px; font-weight: bold; color: #10b981;">₱4,850</div>
        </div>
        <div class="card" style="padding: 20px;">
            <h4 style="color: #64748b; font-size: 14px; margin-bottom: 8px;">Active Bookings</h4>
            <div style="font-size: 28px; font-weight: bold; color: #f59e0b;">8</div>
        </div>
    </div>

    <div class="card">
        <h2>Cafe System Status</h2>
        <p style="color: #94a3b8; margin-top: 10px;">All network nodes and gaming terminals are operating at optimal latency.</p>
    </div>
{% endblock %}